# Ated AI Environment Configuration

# PostgreSQL Connection String (Prisma)
# Example local: postgresql://postgres:postgres@localhost:5432/ated_ai?schema=public
# Example cloud: postgresql://USER:PASSWORD@ep-xyz.aws.neon.tech/ated_ai?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ated_ai?schema=public"

# Authentication Secret (min 32 characters recommended for production)
JWT_SECRET="ated_ai_super_secret_jwt_key_change_me_in_production_1234567890"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

